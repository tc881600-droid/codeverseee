# CodeVerse — production adapter configuration
# This static build runs the local adapter stack (LocalStorage DB, LocalAuth,
# BrowserSandbox + Mock execution adapters, Heuristic tutor). Wiring these
# variables activates the production adapters behind the same service contracts.

# ── Database (Prisma / PostgreSQL) ─────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── Auth (Supabase) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── AI tutor (LLM provider) ────────────────────────────────────────
# Server-only. The browser always talks to /api/ai, never to the provider.
AI_API_KEY=

# ── Code execution sandbox ─────────────────────────────────────────
# Option 1: Self-hosted Docker execution server (recommended)
# Run: cd docker && docker compose up --build
# Server runs on http://localhost:3001
VITE_CODE_EXECUTION_URL=http://localhost:3001

# Option 2: Piston (public API, no setup required)
# Frontend automatically falls back to Piston if Docker server is unreachable
# No configuration needed — uses https://emkc.org/api/v2/piston

# Option 3: Judge0 / custom execution service
# Server-only secret shared with the execution workers.
CODE_EXECUTION_URL=
CODE_EXECUTION_SECRET=
